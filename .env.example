# Google Sheets
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Target Website
TARGET_URL=https://example.com/form

# Automation Settings
HEADLESS=false
MIN_DELAY=500
MAX_DELAY=2000
TYPING_SPEED_MIN=50
TYPING_SPEED_MAX=150

# Error Handling
STOP_ON_ERROR=true
SCREENSHOT_ON_ERROR=true

# Logging
LOG_LEVEL=info
